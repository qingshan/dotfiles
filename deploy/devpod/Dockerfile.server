FROM debian:13

RUN apt-get update && \
    apt install -y \
    openssh-server \
    locales \
    sudo \
    ca-certificates \
    make \
    git

RUN localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8

ENV TZ=America/Los_Angeles
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime

RUN echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen \
  && locale-gen en_US.utf8 \
  && /usr/sbin/update-locale LANG=en_US.UTF-8

RUN groupadd --gid 1000 qingshan && \
    useradd --create-home --shell=/bin/bash --uid=1000 --gid=1000 qingshan && \
    echo "qingshan ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/qingshan && \
    chmod 0440 /etc/sudoers.d/qingshan

# Cache tool installation separately from frequently edited shell helpers.
COPY --chown=qingshan:qingshan Makefile /home/qingshan/.dotfiles/Makefile
COPY --chown=qingshan:qingshan mise /home/qingshan/.dotfiles/mise
COPY --chown=qingshan:qingshan linux /home/qingshan/.dotfiles/linux
RUN sudo -H -u qingshan make -C /home/qingshan/.dotfiles bootstrap

COPY --chown=qingshan:qingshan . /home/qingshan/.dotfiles
RUN sudo -H -u qingshan make -C /home/qingshan/.dotfiles

# The test runner supplies temporary SSH keys at runtime.
RUN install -d -m 0700 -o qingshan -g qingshan /home/qingshan/.ssh && \
    mkdir -p /run/sshd

EXPOSE 22
CMD ["/bin/sh", "-c", "ssh-keygen -A && exec /usr/sbin/sshd -D -e"]
