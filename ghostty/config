# This is the configuration file for Ghostty.

# auto update
auto-update = off

# fonts
font-size = 14
font-family = Jetbrains Mono
font-thicken = true
font-thicken-strength = 255
font-feature = +zero,-liga,-calt

# window
fullscreen = non-native
initial-window = true
quit-after-last-window-closed = true
window-save-state = never
confirm-close-surface = false

# shell
shell-integration = detect
term = xterm-256color
initial-command = /bin/bash -lc 'exec herdr'

# macos
# macos-hidden = always
macos-option-as-alt = true
# macos-titlebar-style = hidden

# quick terminal
quick-terminal-animation-duration = 0
quick-terminal-autohide = false
quick-terminal-position = bottom

# clipboard
copy-on-select = true
selection-clear-on-copy = true

# key bindings
keybind = clear

# key binding for quick terminal
keybind = global:super+escape=toggle_quick_terminal

# key bindings for font size
keybind = super+equal=increase_font_size:1
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size

# key bindings for new workspace
keybind = super+q=text:\x1cd
keybind = super+n=text:\x1cW
keybind = super+shift+n=text:\x1cW
keybind = super+shift+[=text:\x1c{
keybind = super+shift+]=text:\x1c}
keybind = super+shift+digit_1=text:\x1c!
keybind = super+shift+digit_2=text:\x1c@
keybind = super+shift+digit_3=text:\x1c#
keybind = super+shift+digit_4=text:\x1c$
keybind = super+shift+digit_5=text:\x1c%
keybind = super+shift+digit_6=text:\x1c^
keybind = super+shift+digit_7=text:\x1c&
keybind = super+shift+digit_8=text:\x1c*
keybind = super+shift+digit_9=text:\x1c(

# key bindings for tabs
keybind = super+[=text:\x1cp
keybind = super+]=text:\x1cn
keybind = super+digit_1=text:\x1c1
keybind = super+digit_2=text:\x1c2
keybind = super+digit_3=text:\x1c3
keybind = super+digit_4=text:\x1c4
keybind = super+digit_5=text:\x1c5
keybind = super+digit_6=text:\x1c6
keybind = super+digit_7=text:\x1c7
keybind = super+digit_8=text:\x1c8
keybind = super+digit_9=text:\x1c9

# key bindings for new split
keybind = super+t=text:\x1cc
keybind = super+shift+t=text:\x1cC
keybind = super+d=text:\x1c"
keybind = super+shift+d=text:\x1c%
keybind = super+w=text:\x1cx
keybind = super+shift+w=text:\x1c&

# key bindings for goto splits
keybind = super+b=text:\x1c;
keybind = super+h=text:\x1ch
keybind = super+j=text:\x1cj
keybind = super+k=text:\x1ck
keybind = super+l=text:\x1cl

# key bindings for resize splits
keybind = super+shift+h=text:\x1cH
keybind = super+shift+j=text:\x1cJ
keybind = super+shift+k=text:\x1cK
keybind = super+shift+l=text:\x1cL

# key bindings for swap splits
keybind = super+alt+h=text:\x1c\x08
keybind = super+alt+j=text:\x1c\x0a
keybind = super+alt+k=text:\x1c\x0b
keybind = super+alt+l=text:\x1c\x0c

# key bindings for clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+shift+v=paste_from_selection
keybind = copy=copy_to_clipboard
keybind = paste=paste_from_clipboard

# key bindings for scroll page
keybind = super+shift+arrow_up=jump_to_prompt:-1
keybind = super+arrow_up=jump_to_prompt:-1
keybind = super+arrow_down=jump_to_prompt:1
keybind = super+shift+arrow_down=jump_to_prompt:1
keybind = super+page_up=scroll_page_up
keybind = super+page_down=scroll_page_down
keybind = super+home=scroll_to_top
keybind = super+end=scroll_to_bottom

# key bindings for text selection
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+arrow_down=adjust_selection:down
keybind = shift+page_up=adjust_selection:page_up
keybind = shift+page_down=adjust_selection:page_down
keybind = shift+home=adjust_selection:home
keybind = shift+end=adjust_selection:end

# find text and panes
keybind = super+f=text:\x1c[/
keybind = super+shift+f=text:\x1c[?
keybind = super+g=text:\x1cG
keybind = super+shift+g=text:\x1cY

# plugins and popups
keybind = super+r=text:\x1cr
keybind = super+shift+r=text:\x1cR
keybind = super+p=text:\x1cP
keybind = super+shift+p=text:\x1cP
keybind = super+s=text:\x1b:w\x0a
keybind = super+shift+s=text:\x1b:wa\x0a
keybind = super+enter=text:\x1cz
keybind = super+shift+enter=text:\x1cz
keybind = super+shift+b=text:\x1cB
