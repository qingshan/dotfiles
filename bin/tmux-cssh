#!/usr/bin/env bash
set -eo pipefail

directory=""
action="top"
positional_args=()
usage() {
  echo "Usage: tmux-cssh [-a action] [-d directory] cluster" >&2
}
while [[ $# -gt 0 ]]; do
  case $1 in
    -a|--action)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      action="$2"
      shift 2
      ;;
    -d|--directory)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      directory="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      positional_args+=("$@")
      break
      ;;
    -*)
      echo "${0}: invalid option -- '${1}'"
      exit 1
      ;;
    *)
      positional_args+=("$1")
      shift
      ;;
  esac
done

[[ ${#positional_args[@]} -eq 1 ]] || { usage; exit 2; }
cluster=${positional_args[0]}
hosts=()
while IFS= read -r line || [[ -n $line ]]; do
  line=${line%%#*}
  read -r -a nodes <<< "$line"
  hosts+=("${nodes[@]}")
done < "$HOME/.dsh/group/$cluster"

if [[ ${#hosts[@]} -eq 0 ]]; then
  echo "no hosts in cluster $cluster"
  exit 2
fi

controller=${hosts[0]}
tile="tiled"

printf -v ssh_command 'ssh -- %q' "$controller"
tmux new-window "$ssh_command"
tmux rename-window "$cluster"
sleep 0.2
if [ -n "${directory}" ]; then
  printf -v cd_command 'cd -- %q' "$directory"
  tmux send-keys "$cd_command" Enter
fi
for node in "${hosts[@]:1}"; do
  printf -v ssh_command 'ssh -- %q' "$node"
  tmux split-window "$ssh_command"
  sleep 0.2
  if [ -n "${directory}" ]; then
    tmux send-keys "$cd_command" Enter
  fi
  tmux select-layout $tile
done
sleep 0.2
tmux select-pane -t 1
tmux set-window-option synchronize-panes on
tmux set-hook pane-exited "select-layout tiled"
tmux send-keys "$action" Enter
