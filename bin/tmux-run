#!/usr/bin/env bash
# Compatibility entry point for existing tmux-apps/config bindings.
# muxrun owns the target creation and herdr/tmux behavior.
set -euo pipefail

target="right"
directory="$PWD"
name=""

usage() {
  echo "Usage: tmux-run [-d directory] -t [right|bottom|center|top|window|popup] name -- command"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -t|--target)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      target="$2"
      shift 2
      ;;
    -d|--directory)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      directory="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "${0}: invalid option -- '$1'" >&2
      exit 2
      ;;
    *)
      if [[ -n "$name" ]]; then
        echo "${0}: only one pane name is allowed before --" >&2
        exit 2
      fi
      name="$1"
      shift
      ;;
  esac
done

# The old helper treated a name without `-- command` as the command itself.
if [[ $# -eq 0 ]]; then
  [[ -n "$name" ]] || { usage >&2; exit 2; }
  # Preserve the former project-menu entry points used by tmux and Herdr
  # bindings. They are muxrun UI commands, not runner target names.
  case "$name" in
    menu|commands)
      exec muxrun -d "$directory" "$name"
      ;;
  esac
  command=("$name")
else
  command=("$@")
fi

exec muxrun -d "$directory" run -t "$target" "$name" -- "${command[@]}"
