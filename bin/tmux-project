#!/usr/bin/env bash

directory="."
declare -a menu_items

while [[ $# -gt 0 ]]; do
  case $1 in
    -d|--directory)
      directory="$2"
      shift 2
      ;;
    -h|--help)
      # Print help
      echo "Usage: tmux-project -d [directory] [cmd] -- arguments".
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*|--*)
      echo "${0}: invalid option -- '${1}'"
      exit 1
      ;;
    *)
      positional_args+=("$1")
      shift
      ;;
  esac
done

cmd=${positional_args[0]}

function detect_file_type {
  file_name=$(echo $1 | awk -F ':' '{print $1}')
  if [[ $file_name = *.rs ]]; then
    echo "rust"
  elif [[ $file_name = *.go ]]; then
    echo "go"
  elif [[ $file_name = *.md ]]; then
    echo "markdown"
  fi
}

function detect_project {
  if [ -f $directory/Cargo.toml ] ; then
    echo "rust"
  elif [ -f $directory/go.mod ] ; then
    echo "go"
  elif [ -f $directory/justfile ] || [ -f $directory/Justfile ] ; then
    echo "just"
  elif [ -f $directory/Makefile ] ; then
    echo "make"
  fi
}

function detect_file {
  # current file in vim
  local status_line
  if [ "$HERDR_ENV" = "1" ]; then
    # popup/pane/shell custom commands only receive HERDR_ACTIVE_* vars, not HERDR_WORKSPACE_ID
    local workspace="${HERDR_WORKSPACE_ID:-$HERDR_ACTIVE_WORKSPACE_ID}"
    local tab_id pane_id
    tab_id=$(herdr tab list --workspace "$workspace" \
      | jq -r '.result.tabs[] | select(.label == "vim") | .tab_id' | head -1)
    if [ -z "$tab_id" ]; then
      return
    fi
    pane_id=$(herdr pane list --workspace "$workspace" \
      | jq -r --arg tab "$tab_id" '.result.panes[] | select(.tab_id == $tab) | .pane_id' | head -1)
    status_line=$(herdr pane read "$pane_id" --source recent 2>/dev/null \
      | grep -E '(NORMAL|INSERT|VISUAL|V-LINE|V-BLOCK|REPLACE|SELECT|S-LINE|S-BLOCK)' \
      | tail -1)
  else
    status_line=$(tmux capture-pane -p -t :vim 2>/dev/null \
      | grep -E '(NORMAL|INSERT|VISUAL|V-LINE|V-BLOCK|REPLACE|SELECT|S-LINE|S-BLOCK)' \
      | tail -1)
  fi
  if [ -z "$status_line" ]; then
    return
  fi
  # strip nerd-font/powerline separator glyphs, keep plain ascii only
  status_line=$(LC_ALL=C printf '%s' "$status_line" | sed 's/[^ -~]//g')
  local file_name
  file_name=$(echo "$status_line" \
    | sed -E 's/^[[:space:]]*[A-Z-]+[[:space:]]+//' \
    | tr -s ' ' '\n' \
    | grep -vE '^(RO|\+|\|)?$' \
    | head -1)
  if [ -z "$file_name" ]; then
    return
  fi
  local file_line
  file_line=$(echo "$status_line" | grep -oE '[0-9]+:[0-9]+[[:space:]]*$' | awk -F':' '{print $1}')
  echo "$file_name:$file_line"
}

function build_commands {
  local project=$(detect_project)
  if [ ! -z "$project" ]; then
    $project-project all
  fi
}

function build_menu_items {
  local project=$(detect_project)
  local file_name=$(detect_file)
  local file_type=$(detect_file_type $file_name)
  if [ "$file_type" = "markdown" ]; then
    menu_items+=('Preview File' 'p' 'run-shell "tmux-run -t right preview -- glow '$(echo $file_name | awk -F ':' '{print $1}')'"')
    menu_items+=('')
  fi
  case $project in
    rust)
      if [ "$file_type" = "rust" ]; then
        menu_items+=('Test Function' 'f' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' test-function '$file_name')"')
        menu_items+=('Test File' 'F' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' test-file '$file_name')"')
        menu_items+=('')
      fi
      menu_items+=('Test Package' 't' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' test-package '$file_name')"')
      menu_items+=('Test All' 'T' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' test-all)"')
      menu_items+=('Build Package' 'b' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' build-package '$file_name')"')
      menu_items+=('Build All' 'B' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' build-all)"')
      menu_items+=('Run Package' 'r' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' run-package '$file_name')"')
      menu_items+=('Run All' 'R' 'run-shell "tmux-run -t right test -- $(rust-project -d '$directory' run-all)"')
      menu_items+=('')
      ;;
    go)
      if [ $file_type = "go" ]; then
        menu_items+=('Test File' 'f' 'run-shell "tmux-run -t right test -- $(go-project -d '$directory' test-file '$file_name')"')
      fi
      menu_items+=('')
      menu_items+=('Test Package' 't' 'run-shell "tmux-run -t right test -- $(go-project -d '$directory' test-package '$file_name')"')
      menu_items+=('Test All' 'T' 'run-shell "tmux-run -t right test --$(go-project -d test-all)"')
      menu_items+=('Build File' 'b' 'run-shell "tmux-run -t right test -- $(go-project -d '$directory' build-file '$file_name')"')
      menu_items+=('Run File' 'r' 'run-shell "tmux-run -t right test -- $(go-project -d '$directory' run-file '$file_name')"')
      menu_items+=('')
      ;;
    just)
      menu_items+=('Build' 'b' 'run-shell "tmux-run -t right build -- just build"')
      menu_items+=('Run' 'r' 'run-shell "tmux-run -t right run -- just run"')
      menu_items+=('Test' 't' 'run-shell "tmux-run -t right test -- just test"')
      menu_items+=('')
      ;;
    make)
      menu_items+=('Build' 'b' 'run-shell "tmux-run -t right build -- make build"')
      menu_items+=('Run' 'r' 'run-shell "tmux-run -t right run -- make run"')
      menu_items+=('Test' 't' 'run-shell "tmux-run -t right test -- make test"')
      menu_items+=('')
      ;;
  esac
  menu_items+=('Quit' 'q' '')
}

# same items as build_menu_items, but with plain shell commands instead of tmux commands
# (no run-shell wrapper). $(...) substitutions are kept literal, only resolved when a menu
# item is actually selected, not upfront when building the menu
function build_herdr_menu_items {
  local project=$(detect_project)
  local file_name=$(detect_file)
  local file_type=$(detect_file_type $file_name)
  if [ "$file_type" = "markdown" ]; then
    menu_items+=('Preview File' 'p' 'tmux-run -t right preview -- glow '$(echo $file_name | awk -F ':' '{print $1}')'')
  fi
  case $project in
    rust)
      if [ "$file_type" = "rust" ]; then
        menu_items+=('Test Function' 'f' 'tmux-run -t right test -- $(rust-project -d '$directory' test-function '$file_name')')
        menu_items+=('Test File' 'F' 'tmux-run -t right test -- $(rust-project -d '$directory' test-file '$file_name')')
      fi
      menu_items+=('Test Package' 't' 'tmux-run -t right test -- $(rust-project -d '$directory' test-package '$file_name')')
      menu_items+=('Test All' 'T' 'tmux-run -t right test -- $(rust-project -d '$directory' test-all)')
      menu_items+=('Build Package' 'b' 'tmux-run -t right test -- $(rust-project -d '$directory' build-package '$file_name')')
      menu_items+=('Build All' 'B' 'tmux-run -t right test -- $(rust-project -d '$directory' build-all)')
      menu_items+=('Run Package' 'r' 'tmux-run -t right test -- $(rust-project -d '$directory' run-package '$file_name')')
      menu_items+=('Run All' 'R' 'tmux-run -t right test -- $(rust-project -d '$directory' run-all)')
      ;;
    go)
      if [ $file_type = "go" ]; then
        menu_items+=('Test File' 'f' 'tmux-run -t right test -- $(go-project -d '$directory' test-file '$file_name')')
      fi
      menu_items+=('Test Package' 't' 'tmux-run -t right test -- $(go-project -d '$directory' test-package '$file_name')')
      menu_items+=('Test All' 'T' 'tmux-run -t right test --$(go-project -d test-all)')
      menu_items+=('Build File' 'b' 'tmux-run -t right test -- $(go-project -d '$directory' build-file '$file_name')')
      menu_items+=('Run File' 'r' 'tmux-run -t right test -- $(go-project -d '$directory' run-file '$file_name')')
      ;;
    just)
      menu_items+=('Build' 'b' 'tmux-run -t right build -- just build')
      menu_items+=('Run' 'r' 'tmux-run -t right run -- just run')
      menu_items+=('Test' 't' 'tmux-run -t right test -- just test')
      ;;
    make)
      menu_items+=('Build' 'b' 'tmux-run -t right build -- make build')
      menu_items+=('Run' 'r' 'tmux-run -t right run -- make run')
      menu_items+=('Test' 't' 'tmux-run -t right test -- make test')
      ;;
  esac
  menu_items+=('Quit' 'q' '')
}

# render (label key command) triples as an fzf list with single-keystroke shortcuts, the
# herdr equivalent of tmux's display-menu: each key is bound to execute-silent its command
# and immediately close, instead of fuzzy-searching/typing to select. enter also works: it
# runs whichever item is currently highlighted (navigated to via arrow keys)
function fzf_hotkey_menu {
  local i label key command labels=() binds=() commands_by_row=()
  for ((i = 0; i < ${#menu_items[@]}; i += 3)); do
    label=${menu_items[i]}
    if [ -z "$label" ]; then
      continue
    fi
    key=${menu_items[i + 1]}
    command=${menu_items[i + 2]}
    labels+=("($key) $label")
    commands_by_row+=("$command")
    if [ -n "$command" ]; then
      binds+=(--bind "${key}:execute-silent[${command}]+abort")
    else
      binds+=(--bind "${key}:abort")
    fi
  done
  local tmpfile
  tmpfile=$(mktemp)
  # {n} is the zero-based ordinal index of the highlighted item, safe to embed unquoted
  binds+=(--bind "enter:execute-silent(echo {n} > $tmpfile)+abort")
  printf '%s\n' "${labels[@]}" \
    | fzf --layout=reverse --no-sort --prompt '  ' --pointer='➤ ' --marker='➤' "${binds[@]}"
  if [ -s "$tmpfile" ]; then
    local row=$(cat "$tmpfile")
    local selected=${commands_by_row[row]}
    if [ -n "$selected" ]; then
      eval "$selected"
    fi
  fi
  rm -f "$tmpfile"
}

if [ "$HERDR_ENV" = "1" ]; then
  case $cmd in
    commands)
      build_commands | fzf --layout=reverse --no-sort --prompt ' ' --pointer='➤ ' --marker='➤'
      ;;
    menu)
      build_herdr_menu_items
      fzf_hotkey_menu
      ;;
    *)
      echo "Unkown command: $cmd"
      ;;
  esac
  exit 0
fi

case $cmd in
  commands)
    build_commands | fzf --layout=reverse --no-sort --prompt ' ' --pointer='➤ ' --marker='➤'
    ;;
  menu)
    build_menu_items
    tmux display-menu -x C -y C -T "#[align=centre fg=orange] Commands " "${menu_items[@]}"
    ;;
  *)
    echo "Unkown command: $cmd"
    ;;
esac
